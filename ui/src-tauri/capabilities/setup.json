{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "setup",
  "description": "Only bundled setup can configure the single native connection. Remote board/proxy windows have no capabilities.",
  "local": true,
  "windows": [
    "setup"
  ],
  "permissions": [
    "allow-get-setup",
    "allow-connect",
    "allow-disconnect",
    "allow-recover",
    "allow-local-connect",
    "allow-get-forwards",
    "allow-preview-forward",
    "allow-expose-forward",
    "allow-stop-forward",
    "allow-relay-connect",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
