{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "omo ui",
  "version": "0.1.0",
  "identifier": "dev.scolastico.omo.ui",
  "build": {
    "frontendDist": "../setup"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "setup",
        "title": "omo ui \u00b7 Connection",
        "width": 520,
        "height": 740,
        "minWidth": 360,
        "minHeight": 560,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; object-src 'none'; base-uri 'none'; frame-src 'none'",
      "capabilities": [
        "setup"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "A native window for your omo board",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
