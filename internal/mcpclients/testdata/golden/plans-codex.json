{
  "install-absent": {
    "target": {
      "id": "codex",
      "cli": "codex",
      "account": "",
      "config_path": "$HOME/.codex/config.toml"
    },
    "action": "install",
    "file": "$HOME/.codex/config.toml",
    "commands": [
      [
        "codex",
        "mcp",
        "add",
        "omo",
        "--env",
        "OMO_HOME=$OMO_HOME",
        "--",
        "$OMO",
        "mcp",
        "stdio"
      ]
    ],
    "before": null,
    "after": {
      "args": [
        "mcp",
        "stdio"
      ],
      "command": "$OMO",
      "env": {
        "OMO_HOME": "$OMO_HOME"
      }
    },
    "message": "A copy of the file is saved in omo's backups first.",
    "hash": ""
  },
  "install-foreign": {
    "target": {
      "id": "codex",
      "cli": "codex",
      "account": "",
      "config_path": "$HOME/.codex/config.toml"
    },
    "action": "install",
    "file": "$HOME/.codex/config.toml",
    "commands": [
      [
        "codex",
        "mcp",
        "remove",
        "omo"
      ],
      [
        "codex",
        "mcp",
        "add",
        "omo",
        "--env",
        "OMO_HOME=$OMO_HOME",
        "--",
        "$OMO",
        "mcp",
        "stdio"
      ]
    ],
    "before": {
      "http_headers": {
        "Authorization": "Bearer ***"
      },
      "url": "https://omo.example.invalid/mcp"
    },
    "after": {
      "args": [
        "mcp",
        "stdio"
      ],
      "command": "$OMO",
      "env": {
        "OMO_HOME": "$OMO_HOME"
      }
    },
    "message": "The file has an entry named omo that is not omo's bridge; it is replaced. A copy of the file is saved in omo's backups first.",
    "hash": ""
  },
  "install-installed": {
    "target": {
      "id": "codex",
      "cli": "codex",
      "account": "",
      "config_path": "$HOME/.codex/config.toml"
    },
    "action": "install",
    "file": "$HOME/.codex/config.toml",
    "commands": [],
    "before": {
      "args": [
        "mcp",
        "stdio"
      ],
      "command": "$OMO",
      "env": {
        "OMO_HOME": "$OMO_HOME"
      }
    },
    "after": {
      "args": [
        "mcp",
        "stdio"
      ],
      "command": "$OMO",
      "env": {
        "OMO_HOME": "$OMO_HOME"
      }
    },
    "message": "omo is already installed in $HOME/.codex/config.toml.",
    "hash": ""
  },
  "install-outdated": {
    "target": {
      "id": "codex",
      "cli": "codex",
      "account": "",
      "config_path": "$HOME/.codex/config.toml"
    },
    "action": "install",
    "file": "$HOME/.codex/config.toml",
    "commands": [
      [
        "codex",
        "mcp",
        "remove",
        "omo"
      ],
      [
        "codex",
        "mcp",
        "add",
        "omo",
        "--env",
        "OMO_HOME=$OMO_HOME",
        "--",
        "$OMO",
        "mcp",
        "stdio"
      ]
    ],
    "before": {
      "args": [
        "mcp",
        "stdio"
      ],
      "command": "/usr/local/bin/omo"
    },
    "after": {
      "args": [
        "mcp",
        "stdio"
      ],
      "command": "$OMO",
      "env": {
        "OMO_HOME": "$OMO_HOME"
      }
    },
    "message": "The file has omo's bridge with another path or environment; it is replaced. A copy of the file is saved in omo's backups first.",
    "hash": ""
  },
  "remove-absent": {
    "target": {
      "id": "codex",
      "cli": "codex",
      "account": "",
      "config_path": "$HOME/.codex/config.toml"
    },
    "action": "remove",
    "file": "$HOME/.codex/config.toml",
    "commands": [],
    "before": null,
    "after": null,
    "message": "omo is not installed in $HOME/.codex/config.toml.",
    "hash": ""
  },
  "remove-installed": {
    "target": {
      "id": "codex",
      "cli": "codex",
      "account": "",
      "config_path": "$HOME/.codex/config.toml"
    },
    "action": "remove",
    "file": "$HOME/.codex/config.toml",
    "commands": [
      [
        "codex",
        "mcp",
        "remove",
        "omo"
      ]
    ],
    "before": {
      "args": [
        "mcp",
        "stdio"
      ],
      "command": "$OMO",
      "env": {
        "OMO_HOME": "$OMO_HOME"
      }
    },
    "after": null,
    "message": "A copy of the file is saved in omo's backups first.",
    "hash": ""
  }
}
