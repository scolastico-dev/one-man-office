    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.11",
    "@vue/test-utils": "2.6.0",
    "happy-dom": "21.0.4",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
