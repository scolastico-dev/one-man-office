{
  "name": "pushover",
  "version": "2.0.0",
  "description": "Pushover notifications when a ticket needs your attention or an agent asks you a question",
  "default_config": {
    "user_key": "",
    "app_token": "",
    "api_url": "https://api.pushover.net/1/messages.json",
    "priority": 0,
    "sound": ""
  },
  "hooks": [
    {
      "event": "ticket_needs_attention",
      "lua": "notify.lua",
      "timeout": "30s"
    },
    {
      "event": "question_asked",
      "lua": "notify.lua",
      "timeout": "30s"
    },
    {
      "event": "manual",
      "name": "test",
      "description": "Send a test notification",
      "scope": "global",
      "lua": "test.lua",
      "timeout": "30s"
    }
  ]
}
